{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["local>nklmilojevic/renovate-config", "local>nklmilojevic/renovate-config:go-vendor-hash", "helpers:pinGitHubActionDigests"],
  postUpdateOptions: ["gomodTidy", "gomodUpdateImportPaths"],
  nix: { enabled: true },
  lockFileMaintenance: { enabled: true },
  packageRules: [
    {
      description: "The release workflow holds the GitHub release token and the macOS signing and notarization secrets, and runs the composite actions too: Action updates are reviewed, never merged automatically.",
      matchFileNames: [".github/workflows/**", ".github/actions/**"],
      automerge: false,
    },
  ],
}
